{
  "name": "craft-every-aspect",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch-path=server --watch-path=shared server/main.ts",
    "dev:web": "vite --strictPort",
    "build": "vite build",
    "start": "node server/main.ts --serve-dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "cea": "node server/cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@vue/compiler-sfc": "^3.5.45",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "i18next": "^27.1.1",
    "iso-639-1": "^3.1.6",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
